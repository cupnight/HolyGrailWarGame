{
  // 성배가 차는 밤 — 클라우드플레어 Workers 설정
  // public/ 폴더의 게임 파일을 그대로 내주고, /api/ 로 시작하는 요청만 src/worker.js 가 처리한다.
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "holygrailwargame",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // 익명 통계를 담는 D1 데이터베이스 (처음 배포할 때 클라우드플레어가 자동으로 만든다)
  "d1_databases": [{ "binding": "DB", "database_name": "cupnight-stats" }],
  // 같은 곳에서 1분에 20번 넘게 기록을 보내면 막는다
  "ratelimits": [{ "name": "RL", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  "observability": { "enabled": true }
}
